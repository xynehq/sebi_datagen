# Optional process environment. This file is not loaded automatically.
# Export a variable only when the weight or binary is already installed.
# The pipeline does not download models.

# Directory or file containing the local IndicOCR weights.
INDICOCR_MODEL_PATH=

# Directory or file containing the local Chitrapathak weights.
CHITRAPATHAK_MODEL_PATH=

# Tesseract executable, when it is not the default `tesseract` on PATH.
TESSERACT_CMD=

# Leave empty to auto-detect CUDA, then MPS, then CPU.
# INDIC_OCR_DEVICE is preferred. MARATHI_OCR_DEVICE is still accepted.
# Tesseract stays on CPU.
INDIC_OCR_DEVICE=
MARATHI_OCR_DEVICE=

# Python that already has the local OCR packages installed.
MARATHI_OCR_PYTHON=

# Page reader (ocr_service). Copy this file to .env at the repository root.

# Where downloaded page-reader weights are stored. Default is ocr_service/model_cache.
# MODEL_CACHE_DIR=

# Local PEFT folder for chitrapathak-marguj-mixed (adapter_config.json + weights).
# run.sh auto-sets this when ../IndicPhotoOCR/checkpoints/data/chitrapathak_marguj_mixed exists.
# CHITRAPATHAK_MARGUJ_MIXED_ADAPTER=/absolute/path/to/chitrapathak_marguj_mixed

# Table body in finalized output: html (LightOn-style) or markdown.
# OCR_TABLE_FORMAT=html
# INDICPHOTO_OCR_ROOT=/absolute/path/to/IndicPhotoOCR

# Required only for private Hugging Face repos.
# HF_TOKEN=

# If set, every /v1 request must send Authorization: Bearer <key>.
# Leave empty so anyone with the public link can call the API.
# OCR_API_KEY=

# Upload limit in bytes. Default is 30 MB.
# OCR_MAX_UPLOAD_BYTES=31457280

# Longest side of a rendered page, in pixels. Default is 2048.
# OCR_MAX_SIDE=2048

# Where finished readings are stored. Default is data/ocr_captures.
# OCR_CAPTURE_DIR=

# ngrok authtoken for the public site link. Do not commit the real value.
# NGROK_AUTHTOKEN=
